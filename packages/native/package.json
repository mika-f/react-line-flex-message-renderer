{
  "name": "@ohmyteeth/react-native-line-flex-message-renderer",
  "version": "0.1.0",
  "description": "This is a core logic library for rendering LINE Flex Messages in React and React Native.",
  "license": "MIT",
  "author": "Oh my teeth, Co.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ohmyteeth/react-line-flex-message-renderer.git"
  },
  "homepage": "https://github.com/ohmyteeth/react-line-flex-message-renderer",
  "bugs": {
    "url": "https://github.com/ohmyteeth/react-line-flex-message-renderer/issues"
  },
  "keywords": [
    "LINE",
    "Flex Message",
    "React",
    "React Native"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "dev": "run-p dev:*",
    "dev:tsdown": "tsdown --watch",
    "build": "tsup",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prestorybook": "rnstl",
    "storybook:ios": "cross-env STORYBOOK_ENABLED=true react-native run-ios",
    "storybook:android": "cross-env STORYBOOK_ENABLED=true react-native run-android"
  },
  "dependencies": {
    "@ohmyteeth/line-flex-message-renderer-core": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@oxfmt/binding-darwin-arm64": "catalog:",
    "@oxfmt/binding-win32-x64-msvc": "catalog:",
    "@oxlint/binding-darwin-arm64": "catalog:",
    "@oxlint/binding-win32-x64-msvc": "catalog:",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-community/slider": "^5.2.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/new-app-screen": "0.86.0",
    "@storybook/addon-ondevice-actions": "^10.5.0",
    "@storybook/addon-ondevice-controls": "^10.5.0",
    "@storybook/react-native": "^10.5.0",
    "@storybook/react-native-ui-lite": "^10.5.0",
    "@types/node": "^26.1.1",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-native": "^0.86.0",
    "react-native-gesture-handler": "^3.0.2",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-storybook-loader": "^2.0.5",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "^0.10.2",
    "storybook": "^10.5.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-native": "^0.86.0"
  },
  "packageManager": "pnpm@11.12.0",
  "config": {
    "react-native-storybook-loader": {
      "searchDir": [
        "./src/components"
      ],
      "pattern": "**/*.stories.js",
      "outputFile": "./storybook/storyLoader.js"
    }
  }
}